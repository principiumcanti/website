# Datenbank-Konfiguration
DB_HOST=database
DB_USER=principium
DB_PASSWORD=principium_password
DB_NAME=principium_members

# Auth0 Konfiguration
AUTH0_DOMAIN=deine-domain.eu.auth0.com
AUTH0_CLIENT_ID=deine_client_id
AUTH0_AUDIENCE=https://principiumcanti.de/api
AUTH0_NAMESPACE=https://principiumcanti.de

# RSA-Schlüssel für Verschlüsselung/Entschlüsselung
# Im Produktionsbetrieb sollten diese in den Netlify Environment Variables 
# und NICHT in einer Datei gespeichert werden
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
DEIN_PRIVATER_SCHLÜSSEL_HIER
-----END PRIVATE KEY-----"

# Öffentlicher Schlüssel für die Formular-Verschlüsselung im Frontend
# Dies ist ein Beispiel-Schlüssel, der NUR für Entwicklungszwecke verwendet werden sollte
# Für die Produktionsumgebung muss ein eigener sicherer Schlüssel generiert werden
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
DEIN_ÖFFENTLICHER_SCHLÜSSEL_HIER
-----END PUBLIC KEY-----"

# Hinweis: In der Produktion sollte die .env-Datei niemals ins Repo aufgenommen werden
# Kopiere diese Datei nach .env und fülle die tatsächlichen Werte ein